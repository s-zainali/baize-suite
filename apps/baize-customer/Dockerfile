# Stage 1: Build the Vue Frontend within the Monorepo
FROM node:20-alpine AS frontend-builder
WORKDIR /app

# 1. Copy root package files to initialize workspaces
COPY package*.json ./

# 2. Copy the package definitions for the workspaces to cache npm install
COPY packages/ui/package*.json ./packages/ui/
COPY apps/baize-customer/package*.json ./apps/baize-customer/
COPY apps/baize-customer/frontend/package*.json ./apps/baize-customer/frontend/

# 3. Install the node workspaces dependencies
RUN npm ci

# 4. FIX: Copy the actual source files for BOTH the frontend AND the shared packages
COPY packages/ui/ ./packages/ui/
COPY apps/baize-customer/frontend/ ./apps/baize-customer/frontend/

# 5. Build the frontend app directly using the raw Vite binary to expose hidden logs if it fails
RUN cd apps/baize-customer/frontend && npx vite build

# Stage 2: Setup Python Backend & Bundle Static Files
FROM python:3.11-slim
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# Copy backend requirements and install dependencies
COPY apps/baize-customer/backend/requirements.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements.txt

# Copy backend source code
COPY apps/baize-customer/backend/ ./backend/

# Copies from the relative target 'apps/baize-customer/dist' generated by Vite outDir
COPY --from=frontend-builder /app/apps/baize-customer/dist /app/dist

WORKDIR /app/backend

# Expose port and run application via uvicorn
ENV PORT=10000
EXPOSE 10000

CMD uvicorn app:app --host 0.0.0.0 --port $PORT
